<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The phone's own tokens: only the values a phone needs to differ from the shared Metrics.axaml (Samaat.UI).
       Everything else (colours, the tile and hairline radii, the page title, shadows) comes from the shared
       dictionaries, so a change there reaches both apps. DesignSystemTests checks that each value here really differs
       from the shared token for the same role. Decision: docs/decisions/2026-11-05-mobile-improvements.md. -->

  <!-- Touch, not a mouse pointer: 44 px minimum (WCAG 2.5.5, Apple HIG) instead of the desktop's 32 -->
  <x:Double x:Key="Samaat.Mobile.Size.Touch">44</x:Double>
  <!-- Option rows (noise modes, EQ presets) hold a 36 px tile and two lines: 52 instead of 48 -->
  <x:Double x:Key="Samaat.Mobile.Size.OptionRow">52</x:Double>
  <!-- A whole device row is one tap target: thumbnail, name and two status lines -->
  <x:Double x:Key="Samaat.Mobile.Size.DeviceRow">72</x:Double>
  <!-- The bottom navigation: icon above label, the thumb's main target -->
  <x:Double x:Key="Samaat.Mobile.Size.Nav">56</x:Double>

  <!-- Radii grow with the controls: 44 px buttons at 10 (the desktop's 32 px at 6), toasts and nav keys at 12,
       panels and device rows at 14. Tiles (8) and hairlines (2) use the shared tokens. -->
  <CornerRadius x:Key="Samaat.Mobile.Radius.Control">10</CornerRadius>
  <CornerRadius x:Key="Samaat.Mobile.Radius.Overlay">12</CornerRadius>
  <CornerRadius x:Key="Samaat.Mobile.Radius.Panel">14</CornerRadius>

  <!-- Type: one step up from the desktop's ramp, for reading at arm's length on a small screen
       (label 11 to 12, meta 12 to 13, body 13 to 15, panel title 15 to 16). Figures are smaller than the desktop's
       30 so a device row keeps room for its name at 360 px; the pairing code is larger, to compare at a glance.
       The page title (22) is the shared Samaat.FontSize.Title. -->
  <x:Double x:Key="Samaat.Mobile.FontSize.Label">12</x:Double>
  <x:Double x:Key="Samaat.Mobile.FontSize.Meta">13</x:Double>
  <x:Double x:Key="Samaat.Mobile.FontSize.Unit">14</x:Double>
  <x:Double x:Key="Samaat.Mobile.FontSize.Body">15</x:Double>
  <x:Double x:Key="Samaat.Mobile.FontSize.PanelTitle">16</x:Double>
  <x:Double x:Key="Samaat.Mobile.FontSize.Figure">26</x:Double>
  <x:Double x:Key="Samaat.Mobile.FontSize.Code">40</x:Double>
</ResourceDictionary>
