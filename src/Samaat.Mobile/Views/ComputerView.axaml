<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Samaat.Mobile.ViewModels"
             x:Class="Samaat.Mobile.Views.ComputerView"
             x:DataType="vm:ComputerViewModel">
  <StackPanel Spacing="16">

    <!-- Paired: status and forget -->
    <Border Classes="panel" IsVisible="{Binding IsPaired}">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="Auto,*">
          <Border Classes="optionIcon" Classes.on="{Binding IsOnline}" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource Icon.Laptop}" Width="16" Height="16" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding ComputerName}" Classes="panelTitle" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Classes="dot" Classes.on="{Binding IsOnline}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding StatusText}" Classes="meta" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </StackPanel>
        </Grid>
        <Border Classes="alert" IsVisible="{Binding HasLinkError}">
          <TextBlock Text="{Binding LinkError}" TextWrapping="Wrap" />
        </Border>
        <TextBlock Classes="meta" TextWrapping="Wrap"
                   Text="Open an earbuds page to move them between this phone and the computer. Either side can start the move." />
        <Button Classes="subtle" HorizontalAlignment="Left" Content="Forget this computer" Command="{Binding ForgetCommand}" />
      </StackPanel>
    </Border>

    <!-- The computer's earbuds, so you can see where they are before moving them -->
    <Border Classes="panel" IsVisible="{Binding HasComputerEarbuds}">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding ComputerEarbudsTitle}" Classes="panelTitle" Margin="0,0,0,4" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding ComputerEarbuds}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ComputerEarbudsViewModel">
              <Border Classes="row">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Classes="optionIcon" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource Icon.Headphones}" Width="16" Height="16" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <Grid ColumnDefinitions="Auto,*">
                      <Ellipse Classes="dot" Classes.on="{Binding IsConnected}" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <TextBlock Grid.Column="1" Text="{Binding StateText}" Classes="meta" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Comparing codes -->
    <Border Classes="panel" IsVisible="{Binding ShowCode}">
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding PairingTitle}" Classes="panelTitle" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Code}" Classes="code" AutomationProperties.Name="Pairing code" />
        <TextBlock Classes="meta" TextWrapping="Wrap" Text="Check that the computer shows the same code, then tap Pair on both" />
        <Grid ColumnDefinitions="*,12,*">
          <Button Classes="primary" HorizontalAlignment="Stretch" Content="Pair" Command="{Binding ConfirmCommand}" IsEnabled="{Binding !IsAnswering}" />
          <Button Grid.Column="2" Classes="subtle" HorizontalAlignment="Stretch" Content="Cancel" Command="{Binding CancelCommand}"
                  IsEnabled="{Binding !IsAnswering}" />
        </Grid>
        <TextBlock Text="{Binding PairingStatus}" Classes="meta" />
      </StackPanel>
    </Border>

    <!-- Not paired: computers announcing pairing on this Wi-Fi -->
    <Border Classes="panel" IsVisible="{Binding ShowNearby}">
      <StackPanel Spacing="12">
        <TextBlock Text="Pair with a computer" Classes="panelTitle" />
        <TextBlock Text="{Binding HowToText}" Classes="meta" TextWrapping="Wrap" />
        <StackPanel Spacing="8" IsVisible="{Binding ShowSearching}">
          <ProgressBar Classes="busy" />
          <TextBlock Text="Looking for computers…" Classes="meta" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Nearby}" IsVisible="{Binding HasNearby}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NearbyComputerViewModel">
              <Border Classes="row">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Classes="optionIcon" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource Icon.Laptop}" Width="16" Height="16" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Classes="meta" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="primary" Content="Pair" Command="{Binding PairCommand}"
                          AutomationProperties.Name="{Binding PairAccessibleName}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ProgressBar Classes="busy" IsVisible="{Binding IsDialing}" />
      </StackPanel>
    </Border>

    <Border Classes="alert critical" IsVisible="{Binding HasPairingError}">
      <TextBlock Text="{Binding PairingError}" TextWrapping="Wrap" FontWeight="SemiBold" />
    </Border>
  </StackPanel>
</UserControl>
