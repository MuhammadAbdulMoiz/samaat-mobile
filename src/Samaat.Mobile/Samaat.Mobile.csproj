<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The phone app's UI and logic. Platform-neutral so tests render it headless; Samaat.Android hosts it. -->
    <TargetFramework>net10.0</TargetFramework>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <!-- The desktop's device profiles and artwork photos, for the simulator and tests (Android ships them as assets). -->
    <Content Include="$(SamaatShared)devices\**\*.json" LinkBase="devices" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(SamaatShared)devices\**\*.png" LinkBase="devices" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(SamaatShared)src\Samaat.Core\Samaat.Core.csproj" />
    <ProjectReference Include="$(SamaatShared)src\Samaat.UI\Samaat.UI.csproj" />
    <ProjectReference Include="$(SamaatShared)src\Samaat.Handoff\Samaat.Handoff.csproj" />
    <ProjectReference Include="$(SamaatShared)src\Samaat.Simulator\Samaat.Simulator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Samaat.Mobile.Tests" />
  </ItemGroup>
</Project>
