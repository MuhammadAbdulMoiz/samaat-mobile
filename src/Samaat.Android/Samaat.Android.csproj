<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The Android app: hosts Samaat.Mobile's UI and wires in the Android platform layer.
         Built only by the Android CI job (it needs the Android workload and SDK); see Samaat.Mobile.slnx. -->
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>io.samaat.app</ApplicationId>
    <ApplicationTitle>Samaat</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- See Samaat.Platform.Android.csproj: Android bindings warn a lot and this project only builds in its own CI job. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Core's device catalog and settings use reflection-based System.Text.Json, which trimmed builds turn off by default. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <!-- The desktop's device catalog, profiles and artwork photos; extracted on start (AndroidHost.ExtractDevices). -->
    <!-- Link, not LinkBase: the files sit outside the project, and LinkBase kept their full path inside the APK. -->
    <AndroidAsset Include="$(SamaatShared)devices\**\*.json" Link="Assets\devices\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="$(SamaatShared)devices\**\*.png" Link="Assets\devices\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Samaat.Mobile\Samaat.Mobile.csproj" />
    <ProjectReference Include="..\Samaat.Platform.Android\Samaat.Platform.Android.csproj" />
    <!-- The one list of shipped drivers (Jieli, Fast Pair, Bose), shared with the desktop app and CLI. -->
    <ProjectReference Include="$(SamaatShared)src\Samaat.Drivers\Samaat.Drivers.csproj" />
  </ItemGroup>
</Project>
