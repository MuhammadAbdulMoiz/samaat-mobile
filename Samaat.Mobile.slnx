<Solution>
  <!-- Everything that builds without the Android SDK: the phone UI, the phone preview for computers, and the tests. -->
  <Folder Name="/src/">
    <Project Path="src/Samaat.Mobile/Samaat.Mobile.csproj" />
    <Project Path="src/Samaat.Mobile.Preview/Samaat.Mobile.Preview.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/Samaat.Mobile.Tests/Samaat.Mobile.Tests.csproj" />
  </Folder>
  <Folder Name="/shared (external/samaat.io)/">
    <Project Path="external/samaat.io/src/Samaat.Core/Samaat.Core.csproj" />
    <Project Path="external/samaat.io/src/Samaat.Transport/Samaat.Transport.csproj" />
    <Project Path="external/samaat.io/src/Samaat.Handoff/Samaat.Handoff.csproj" />
    <Project Path="external/samaat.io/src/Samaat.UI/Samaat.UI.csproj" />
    <Project Path="external/samaat.io/src/Samaat.Simulator/Samaat.Simulator.csproj" />
    <Project Path="external/samaat.io/src/Samaat.Protocols.Standard/Samaat.Protocols.Standard.csproj" />
    <Project Path="external/samaat.io/src/Samaat.Protocols.Jieli/Samaat.Protocols.Jieli.csproj" />
    <Project Path="external/samaat.io/src/Samaat.Protocols.FastPair/Samaat.Protocols.FastPair.csproj" />
    <Project Path="external/samaat.io/src/Samaat.Protocols.Bose/Samaat.Protocols.Bose.csproj" />
    <Project Path="external/samaat.io/src/Samaat.Drivers/Samaat.Drivers.csproj" />
